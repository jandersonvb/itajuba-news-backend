# Desenvolvimento local. Em produção, use NODE_ENV=production (ou não defina): a API confere a
# configuração ao iniciar e nunca escreve e-mails no log.
NODE_ENV=development
POSTGRES_PORT=5432
DATABASE_URL=postgresql://itajuba:local_dev_only@localhost:5432/itajuba_news
DATABASE_SSL=false
JWT_SECRET=
INTERNAL_API_KEY=
PORT=4000
PORTAL_SLUG=itajuba-news
FRONTEND_ORIGIN=http://localhost:3000
ENABLE_DOCS=true
MEDIA_DIR=uploads
SEED_DEMO=false
# E-mail: RESEND_API_KEY (API HTTPS, funciona onde o SMTP é bloqueado) ou SMTP_*. MAIL_FROM usa um domínio verificado.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
