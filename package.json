{
  "name": "@itajuba-news/backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "db:migrate": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "db:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "admin:create": "ts-node src/scripts/create-admin.ts",
    "admin:reset-password": "ts-node src/scripts/reset-admin-password.ts",
    "db:seed": "ts-node src/scripts/seed.ts",
    "setup": "node scripts/setup.mjs",
    "start": "node dist/main.js",
    "start:prod": "npm run db:migrate:prod && npm run db:seed:prod && node dist/main.js",
    "start:dev": "nest start --watch",
    "db:migrate:prod": "typeorm migration:run -d dist/database/data-source.js",
    "db:seed:prod": "node dist/scripts/seed.js",
    "admin:create:prod": "node dist/scripts/create-admin.js",
    "admin:reset-password:prod": "node dist/scripts/reset-admin-password.js",
    "db:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "pg-mem": "^3.0.5",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
